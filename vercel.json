{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(.*)\\.(js|css|woff2|png)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" } ] }
  ],
  "functions": {
    "api/img.js": { "maxDuration": 20 },
    "api/pwhales.js": { "maxDuration": 30 },
    "api/rpc.js": { "maxDuration": 30 }
  }
}
